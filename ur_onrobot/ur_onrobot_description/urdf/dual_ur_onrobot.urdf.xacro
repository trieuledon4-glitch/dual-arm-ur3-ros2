<?xml version="1.0"?>
<robot name="dual_ur_onrobot" xmlns:xacro="http://ros.org/wiki/xacro">
    <!--
      File nay GOI LAI dung macro "ur_onrobot" co san trong package
      ur_onrobot_description (khong sua gi ben trong macro do o day - viec sua
      macro da lam o file ur_onrobot_macro.xacro roi), chi goi 2 LAN
      voi 2 tf_prefix va 2 name khac nhau.
    -->
    <xacro:arg name="ur_type" default="ur3e"/>
    <xacro:arg name="onrobot_type" default="rg2"/>
    <xacro:arg name="use_fake_hardware" default="true"/>

    <xacro:include filename="$(find ur_onrobot_description)/urdf/ur_onrobot_macro.xacro"/>

    <link name="world"/>

    <!-- ================= TAY 1 (arm1_) ================= -->
    <!-- Dat tai goc toa do, mat huong ve truc +X -->
    <xacro:ur_onrobot
        parent="world"
        robot_ip="192.168.56.101"
        ur_type="$(arg ur_type)"
        onrobot_type="$(arg onrobot_type)"
        tf_prefix="arm1_"
        use_fake_hardware="$(arg use_fake_hardware)"
        joint_limits_parameters_file="$(find ur_description)/config/$(arg ur_type)/joint_limits.yaml"
        kinematics_parameters_file="$(find ur_description)/config/$(arg ur_type)/default_kinematics.yaml"
        physical_parameters_file="$(find ur_description)/config/$(arg ur_type)/physical_parameters.yaml"
        visual_parameters_file="$(find ur_description)/config/$(arg ur_type)/visual_parameters.yaml"
        script_filename="$(find ur_client_library)/resources/external_control.urscript"
        output_recipe_filename="$(find ur_robot_driver)/resources/rtde_output_recipe.txt"
        input_recipe_filename="$(find ur_robot_driver)/resources/rtde_input_recipe.txt"
        >
        <origin xyz="0 0 0" rpy="0 0 0" />
    </xacro:ur_onrobot>

    <!-- ================= TAY 2 (arm2_) ================= -->
    <!-- Dat cach Tay 1 0.6m theo truc X, xoay 180 do de quay mat lai Tay 1
         -> vung khong gian giua 2 tay se la vung ca 2 tay cung with toi duoc. -->
    <xacro:ur_onrobot
        parent="world"
        robot_ip="192.168.56.102"
        ur_type="$(arg ur_type)"
        onrobot_type="$(arg onrobot_type)"
        tf_prefix="arm2_"
        use_fake_hardware="$(arg use_fake_hardware)"
        joint_limits_parameters_file="$(find ur_description)/config/$(arg ur_type)/joint_limits.yaml"
        kinematics_parameters_file="$(find ur_description)/config/$(arg ur_type)/default_kinematics.yaml"
        physical_parameters_file="$(find ur_description)/config/$(arg ur_type)/physical_parameters.yaml"
        visual_parameters_file="$(find ur_description)/config/$(arg ur_type)/visual_parameters.yaml"
        script_filename="$(find ur_client_library)/resources/external_control.urscript"
        output_recipe_filename="$(find ur_robot_driver)/resources/rtde_output_recipe.txt"
        input_recipe_filename="$(find ur_robot_driver)/resources/rtde_input_recipe.txt"
        >
        <origin xyz="0.7 0 0" rpy="0 0 3.14159" />
    </xacro:ur_onrobot>

</robot>
